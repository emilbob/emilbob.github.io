# Required. Create at https://openrouter.ai/keys — set a credit limit on the key.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Any slug from https://openrouter.ai/models
# Default: anthropic/claude-haiku-4.5
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional. Comma-separated origin allowlist. Overrides the built-in default of
# https://emilbob.github.io + localhost:5173 + localhost:4173
ALLOWED_ORIGINS=https://emilbob.github.io,http://localhost:5173
